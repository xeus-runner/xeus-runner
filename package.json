{
  "name": "xeus-runner",
  "version": "0.0.1",
  "description": "Run xeus WebAssembly kernels in TypeScript/JavaScript projects outside of JupyterLite",
  "homepage": "https://github.com/xeus-runner/xeus-runner#readme",
  "license": "BSD-3-Clause",
  "author": "Ian Thomas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xeus-runner/xeus-runner.git"
  },
  "bugs": {
    "url": "https://github.com/xeus-runner/xeus-runner/issues"
  },
  "files": [
    "lib/**/*.{d.ts,js,js.map}",
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc && npm run build:copy-dts",
    "build:copy-dts": "copyfiles -u 1 \"src/**/*.d.ts\" lib",
    "lint": "npx @biomejs/biome check --write",
    "lint:check": "npx @biomejs/biome check",
    "prepack": "npm install && npm run build"
  },
  "dependencies": {
    "@emscripten-forge/mambajs": "^0.22.0",
    "@emscripten-forge/untarjs": "^5.3.3",
    "@jupyterlite/xeus-core": "^5.0.0",
    "@lumino/coreutils": "^2.2.3",
    "@lumino/signaling": "^2.1.6",
    "coincident": "^4.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@jupyterlab/services": "^7.6.3",
    "copyfiles": "^2.4.1",
    "typescript": "^7.0.2"
  }
}
