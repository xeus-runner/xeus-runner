{
  "name": "@xeus-runner/xeus-runner",
  "version": "0.0.1",
  "description": "Run xeus WebAssembly kernels in TypeScript/JavaScript outside of JupyterLite",
  "homepage": "https://github.com/xeus-runner/xeus-runner#readme",
  "license": "BSD-3-Clause",
  "author": "Ian Thomas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xeus-runner/xeus-runner.git"
  },
  "bugs": {
    "url": "https://github.com/xeus-runner/xeus-runner/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib/**/*.{d.ts,js,js.map}",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "dist_node/**/*.{js,js.map,wasm}",
    "dist_web/**/*.{js,js.map,wasm}"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "node": "./dist_node/xeus-runner.js",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node esbuild_node.mjs && node esbuild_web.mjs",
    "lint": "npx @biomejs/biome check --write",
    "lint:check": "npx @biomejs/biome check",
    "prebuild": "node -p \"'// Autogenerated, do not modify.\\nexport const version = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/version.ts",
    "prepack": "npm install && npm run build"
  },
  "dependencies": {
    "@emscripten-forge/mambajs": "^0.24.0",
    "@emscripten-forge/untarjs": "^5.4.1",
    "@jupyterlite/xeus-core": "^6.0.0",
    "@lumino/coreutils": "^2.2.3",
    "@lumino/signaling": "^2.1.6",
    "coincident": "^4.1.1",
    "comlink": "^4.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@jupyterlab/services": "^7.6.3",
    "@types/node": "^26.6.2",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.28.2",
    "path-browserify": "^1.0.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  }
}
