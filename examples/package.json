{
  "name": "xeus-runner-examples",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node create_examples_web.mjs",
    "build": "tsc --noEmit && node esbuild_node.mjs && node esbuild_web.mjs",
    "serve": "concurrently 'npm run serve:simple' 'npm run serve:cross-origin'",
    "serve:simple": "npx static-handler --port 4500 dist_web/",
    "serve:cross-origin": "npx static-handler --coi --port 4501 dist_web/"
  },
  "dependencies": {
    "@xeus-runner/xeus-runner": "file:.."
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.28.2",
    "static-handler": "^0.5.3",
    "typescript": "^6.0.3"
  }
}
