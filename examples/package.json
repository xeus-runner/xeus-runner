{
  "name": "xeus-runner-examples",
  "private": true,
  "scripts": {
    "build": "node create_examples.mjs && tsc --noEmit && node esbuild.config.mjs",
    "postbuild": "npm run postbuild:copy-assets && npm run postbuild:copy-dist",
    "postbuild:copy-assets": "copyfiles -u 1 \"assets/*\" dist",
    "postbuild:copy-dist": "copyfiles -f \"../dist/*_web_worker_impl.js\" ../dist/unpack.wasm dist",
    "serve": "concurrently 'npm run serve:simple' 'npm run serve:cross-origin'",
    "serve:simple": "npx static-handler --port 4500 dist/",
    "serve:cross-origin": "npx static-handler --coi --port 4501 dist/"
  },
  "dependencies": {
    "xeus-runner": "file:.."
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.28.2",
    "static-handler": "^0.5.3",
    "typescript": "^6.0.3"
  }
}
