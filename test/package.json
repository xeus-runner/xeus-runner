{
  "name": "xeus-runner-tests",
  "version": "0.0.1",
  "description": "xeus-runner tests",
  "license": "BSD-3-Clause",
  "author": "Ian Thomas",
  "type": "module",
  "main": "index.js",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "postbuild": "npm run postbuild:copy-assets && npm run postbuild:rename-unpack",
    "postbuild:copy-assets": "copyfiles -u 1 \"assets/*\" dist",
    "postbuild:rename-unpack": "mv dist/unpack-*.wasm dist/unpack.wasm",
    "serve": "npx static-handler --port 4500 dist/",
    "test": "npm run test:unit && npm run test:integration",
    "test:integration": "cd integration-tests && playwright test --project=chromium",
    "test:integration:ui": "cd integration-tests && playwright test --project=chromium --ui",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest unit-tests/env_lock.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/jest": "^30.0.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.0",
    "playwright": "^1.62.1",
    "static-handler": "^0.5.3",
    "ts-jest": "^29.4.12",
    "typescript": "^7.0.2",
    "xeus-runner": "file:.."
  }
}
