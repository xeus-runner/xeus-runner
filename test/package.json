{
  "name": "xeus-runner-tests",
  "version": "0.0.1",
  "description": "xeus-runner tests",
  "license": "BSD-3-Clause",
  "author": "Ian Thomas",
  "type": "module",
  "main": "index.js",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && npm run build:web",
    "build:web": "node esbuild_web.mjs",
    "typecheck": "tsc --noEmit",
    "serve": "concurrently 'npm run serve:simple' 'npm run serve:cross-origin'",
    "serve:simple": "npx static-handler --port 4500 dist_web/",
    "serve:cross-origin": "npx static-handler --coi --port 4501 dist_web/",
    "show_cache": "ls .pkg_cache",
    "test": "npm run test:unit && npm run test:node && npm run test:web",
    "test:node": "NODE_OPTIONS='--experimental-vm-modules --import ./tests_node/fetch_preload.ts' sh -c 'jest \"${@:-tests_node}\"' --",
    "test:web": "cd tests_web && playwright test --project=chromium",
    "test:web:ui": "cd tests_web && playwright test --project=chromium --ui",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest tests_unit/env_lock.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/jest": "^30.0.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "jest": "^30.5.0",
    "playwright": "^1.62.1",
    "static-handler": "^0.5.3",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "xeus-runner": "file:.."
  }
}
